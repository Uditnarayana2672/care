# Postgres in docker; for no-docker local dev use: sqlite+aiosqlite:///./carebridge.db
DATABASE_URL=postgresql+asyncpg://carebridge:carebridge@postgres:5432/carebridge
# Empty = in-process events/cache (single process dev)
REDIS_URL=redis://redis:6379/0
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io   # confirm exact URL in docs / Cloud UI
# Empty key => local memory backend (DB-backed, same interface) so the demo runs offline
HINDSIGHT_API_KEY=
# Empty key => deterministic rule-based agent driver
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b
JWT_SECRET=change-me
ORG_SLUG=demo
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000
MEMORY_ENABLED=true
APP_TZ=Asia/Kolkata
